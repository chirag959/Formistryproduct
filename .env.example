# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Postgres (used by docker-compose to provision the db) ---
POSTGRES_USER=formistry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=formistry

# --- Backend ---
# The api service builds DATABASE_URL from the POSTGRES_* vars above; override
# only if pointing at an external database.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Agency admin bootstrapped on first startup (only if no users exist yet).
SEED_ADMIN_EMAIL=admin@hypemarketer.in
SEED_ADMIN_PASSWORD=change-me

# --- WhatsApp via AiSensy (BSP on Meta Cloud API) ---
AISENSY_API_BASE=https://backend.aisensy.com
# Global fallback API key (AiSensy dashboard → Manage → API Key). Each
# workspace can override this with its own key for true tenant isolation.
AISENSY_API_KEY=
# Shown on the AiSensy contact as the message source.
AISENSY_SOURCE=rebooking-tool
# Shared secret required on the inbound webhook. Configure AiSensy to POST to
#   https://<host>/webhooks/aisensy?token=<this value>
AISENSY_WEBHOOK_TOKEN=

# --- CORS ---
# Comma-separated origins, or * for all (dev only).
CORS_ORIGINS=*
