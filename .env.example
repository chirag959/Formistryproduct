# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# --- Postgres (used by docker-compose to provision the db) ---
POSTGRES_USER=formistry
POSTGRES_PASSWORD=change-me
POSTGRES_DB=formistry

# --- Backend ---
# The api service builds DATABASE_URL from the POSTGRES_* vars above; override
# only if pointing at an external database.
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Agency admin bootstrapped on first startup (only if no users exist yet).
SEED_ADMIN_EMAIL=admin@hypemarketer.in
SEED_ADMIN_PASSWORD=change-me

# --- WhatsApp Cloud API (Meta) ---
# Graph API version base. Confirm the current version in Meta's docs.
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
# System-user / app access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# Token you invent and paste into Meta's webhook config; echoed on GET verify.
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta → used to validate X-Hub-Signature-256 on callbacks.
WHATSAPP_APP_SECRET=

# --- CORS ---
# Comma-separated origins, or * for all (dev only).
CORS_ORIGINS=*
